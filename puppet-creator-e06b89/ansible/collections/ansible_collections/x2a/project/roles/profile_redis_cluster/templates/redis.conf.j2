# Redis configuration — Managed by Ansible
# Node: {{ ansible_facts['fqdn'] }}

bind {{ redis_cluster_bind | join(' ') }}
port {{ redis_cluster_port }}
daemonize yes
pidfile /var/run/redis/redis-server.pid
logfile {{ redis_cluster_log_dir }}/redis-server.log
loglevel notice

# Security
requirepass {{ redis_cluster_password }}

# Persistence
appendonly {{ 'yes' if redis_cluster_appendonly else 'no' }}
appendfilename "appendonly.aof"
appendfsync {{ redis_cluster_appendfsync }}
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# RDB snapshots
save 900 1
save 300 10
save 60 10000
dbfilename dump.rdb
dir {{ redis_cluster_workdir }}

# Memory
maxmemory {{ redis_cluster_maxmemory_mb }}mb
maxmemory-policy {{ redis_cluster_maxmemory_policy }}

# Network
tcp-backlog 511
timeout 0
tcp-keepalive 300
