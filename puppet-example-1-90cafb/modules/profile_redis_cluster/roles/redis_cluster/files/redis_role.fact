#!/usr/bin/env python3

import json
import os
import re

def main():
    redis_role = 'primary'
    
    # Check for replica configuration
    config_files = [
        '/etc/redis/conf.d/replica.conf',
        '/etc/redis/redis.conf'
    ]
    
    for config_file in config_files:
        if os.path.exists(config_file):
            try:
                with open(config_file, 'r') as f:
                    content = f.read()
                    if re.search(r'replicaof\s+\S+\s+\d+', content) or re.search(r'slaveof\s+\S+\s+\d+', content):
                        redis_role = 'replica'
                        break
            except Exception:
                pass
    
    # Return the fact as JSON
    print(json.dumps({'redis_role': redis_role}))

if __name__ == '__main__':
    main()