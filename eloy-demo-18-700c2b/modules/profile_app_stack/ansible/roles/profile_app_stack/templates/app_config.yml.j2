# Application Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

app_name: {{ app_name }}
environment: {{ app_environment }}

# Server settings
host: 0.0.0.0
port: {{ app_port }}
workers: {{ worker_count }}
max_requests: {{ max_requests }}
log_level: {{ log_level }}

# Database settings
database:
  host: {{ db_host }}
  port: {{ db_port | default('5432') }}
  name: {{ db_name }}
  user: {{ db_user }}
  # Password is set via environment variable

# Redis settings
redis:
  host: {{ redis_host | default('localhost') }}
  port: {{ redis_port | default('6379') }}
  db: {{ redis_db | default('0') }}

# Application paths
paths:
  base: {{ app_base_dir }}
  data: {{ app_data_dir }}
  logs: {{ app_log_dir }}
  temp: /tmp/{{ app_name }}

# Feature flags
features:
  enable_cache: {{ enable_cache | default('true') }}
  debug_mode: {{ 'true' if app_environment == 'development' or app_environment == 'staging' else 'false' }}
  metrics_enabled: {{ metrics_enabled | default('true') }}