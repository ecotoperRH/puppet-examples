server {
    listen 80;
    server_name {{ app_domain | default('_') }};

    access_log {{ nginx_log_dir }}/{{ app_name }}_access.log;
    error_log {{ nginx_log_dir }}/{{ app_name }}_error.log;

    location / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        alias {{ app_base_dir }}/static/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    location /media/ {
        alias {{ app_data_dir }}/media/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    # Health check endpoint
    location /health {
        proxy_pass http://127.0.0.1:{{ app_port }}/health;
        proxy_set_header Host $host;
        access_log off;
        allow 127.0.0.1;
        {% if internal_network is defined %}
        allow {{ internal_network }};
        {% endif %}
        deny all;
    }

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}