groups:
- name: {{ app_name }}_alerts
  rules:
  - alert: {{ app_name | title }}InstanceDown
    expr: up{job="{{ app_name }}"} == 0
    for: 5m
    labels:
      severity: critical
      service: {{ app_name }}
    annotations:
      summary: "{{ app_name | title }} instance is down"
      description: "{{ app_name | title }} instance has been down for more than 5 minutes."

  - alert: {{ app_name | title }}HighCPUUsage
    expr: process_cpu_seconds_total{job="{{ app_name }}"} > 0.85
    for: 10m
    labels:
      severity: warning
      service: {{ app_name }}
    annotations:
      summary: "{{ app_name | title }} high CPU usage"
      description: "{{ app_name | title }} has high CPU usage (> 85%) for more than 10 minutes."

  - alert: {{ app_name | title }}HighMemoryUsage
    expr: process_resident_memory_bytes{job="{{ app_name }}"} / node_memory_MemTotal_bytes > 0.8
    for: 10m
    labels:
      severity: warning
      service: {{ app_name }}
    annotations:
      summary: "{{ app_name | title }} high memory usage"
      description: "{{ app_name | title }} is using more than 80% of available memory for more than 10 minutes."

  - alert: {{ app_name | title }}HighRequestLatency
    expr: http_request_duration_seconds{job="{{ app_name }}", quantile="0.9"} > 1
    for: 5m
    labels:
      severity: warning
      service: {{ app_name }}
    annotations:
      summary: "{{ app_name | title }} high request latency"
      description: "{{ app_name | title }} has a 90th percentile latency of more than 1s for more than 5 minutes."